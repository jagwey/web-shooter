{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jagwey Web Shooter",
  "version": "0.5.1",
  "identifier": "com.jagwey.webshooter",
  "build": {
    "beforeDevCommand": "npm run prepare:assets && npm run dev",
    "devUrl": "http://127.0.0.1:4731",
    "beforeBuildCommand": "npm run prepare:assets && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "control",
        "title": "Jagwey Web Shooter",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Jagwey Overlay",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' blob: data: https://cdn.jsdelivr.net https://storage.googleapis.com https://generativelanguage.googleapis.com https://api.groq.com https://openrouter.ai https://api.openai.com https://text.pollinations.ai http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCOTc5NEFCQjcxRkVGQjMKUldTejd4KzNxNVNYMjB3bE5vdTd4RmJyN3A3UGtGcG5uNkNBaUZhOGhKWUVneElNUE5TNW5XMXUK",
      "endpoints": [
        "https://github.com/jagwey/web-shooter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
